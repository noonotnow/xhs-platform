# Preferred server-only XHS database override
# XHS_DATABASE_URL=postgresql://...

# Managed Neon integration (pooled and unpooled)
XHS_DATABASE_POSTGRES_URL=postgresql://...
XHS_DATABASE_POSTGRES_URL_NON_POOLING=postgresql://...

# Backward-compatible database connection fallbacks
DATABASE_URL=postgresql://...
# POSTGRES_URL=postgresql://...

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=xhs-images
# Upload origin used for ownership validation; API responses use the canonical images domain.
R2_PUBLIC_URL=https://images.xhs.justlikekatie.com

# Vibe Atlas integration media upload (use at least 32 random characters)
PLAN_SECRET=

# Public note/feed auth (legacy clients only; signup and login are disabled)
JWT_SECRET=
NEXTAUTH_URL=https://xhs.justlikekatie.com

# Cloudflare Access operator auth
CLOUDFLARE_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUDIENCE=your-access-application-aud
CLOUDFLARE_ACCESS_OPERATOR_EMAILS=katie@example.com

# XHS Microservice connection
XHS_MICROSERVICE_URL=https://your-service.railway.app
XHS_API_KEY=your-microservice-api-key
UPLOAD_TOKEN_SECRET=generate-a-long-random-shared-secret

# Canonical CREATE Posts database (server-only)
NOTION_API_KEY=
NOTION_POSTS_DB_ID=

# Mac-local RedNote browser worker (server-only, at least 32 random characters)
LOCAL_PUBLISH_WORKER_TOKEN=
# Optional claim lease in seconds (default 7200; allowed range 60-86400)
LOCAL_PUBLISH_JOB_LEASE_SECONDS=7200
